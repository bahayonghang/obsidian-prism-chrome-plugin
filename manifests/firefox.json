{
  "manifest_version": 3,
  "name": "Obsidian Prism Web — Community Edition",
  "short_name": "Prism Web",
  "version": "0.4.0",
  "description": "Community adaptation of Obsidian Prism themes and reading tools for ChatGPT and Gemini. Optional manual translation.",
  "author": "bahayonghang; upstream design by RMvdesi",
  "homepage_url": "https://github.com/bahayonghang/obsidian-prism-chrome-plugin",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": ["src/config-schema.js", "src/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "obsidian-prism-web@bahayonghang.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["websiteContent", "personalCommunications", "authenticationInfo"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Obsidian Prism Web settings",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "popup/popup.html?mode=options",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "css": ["styles/prism-tokens.css", "styles/hosts.css"],
      "js": ["src/config-schema.js", "src/early-boot.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "css": ["vendor/temml/temml-local.css"],
      "js": ["vendor/temml/temml.js", "src/formula.js", "src/adapters.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
